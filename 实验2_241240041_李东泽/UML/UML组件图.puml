@startuml
!pragma layout smetana
skinparam defaultFontName Microsoft YaHei
skinparam shadowing false
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam packageStyle rectangle
title UML组件图——模块划分与交互边界（人工优化版）

actor "普通用户" as User
actor "管理员" as Admin

package "表现层" {
  [Vue 3 用户端] as Web
  [Vue 3 管理后台] as AdminWeb
}

package "应用层（Spring Boot 模块化单体）" {
  [REST 接口层] as API

  package "业务模块" as Biz {
    [认证与用户] as Auth
    [商品与分类] as Product
    [预约与交易] as Trade
    [审核与治理] as Governance
    [查询与统计] as Query
    [通知与日志] as Support
    [超时调度] as Scheduler
  }

  [数据访问端口] as DataPort
  [缓存与幂等端口] as CachePort
  [图片存储端口] as ImagePort
}

package "基础设施层" {
  [MySQL 适配器] as MySQLAdapter
  [Redis 适配器] as RedisAdapter
  [对象存储适配器] as ObjectAdapter
  database "MySQL\\n业务数据与事务" as DB
  database "Redis\\n会话、幂等与缓存" as Redis
  folder "对象存储\\n商品图片" as ObjectStorage
}

User --> Web
Admin --> AdminWeb
Web --> API : HTTPS/JSON
AdminWeb --> API : HTTPS/JSON

API --> Auth
API --> Product
API --> Trade
API --> Governance
API --> Query
API --> Support

Product --> Governance : 提交审核
Trade --> Product : 原子更新商品状态
Trade --> Support : 交易通知、操作留痕
Governance --> Support : 治理通知、操作留痕
Scheduler --> Trade : 处理24小时超时

Biz --> DataPort : 持久化与事务
Biz --> CachePort : 会话、幂等、热点缓存
Product --> ImagePort : 商品图片

DataPort --> MySQLAdapter
CachePort --> RedisAdapter
ImagePort --> ObjectAdapter
MySQLAdapter --> DB
RedisAdapter --> Redis
ObjectAdapter --> ObjectStorage

note right of Biz
模块间只保留必要业务调用；
商品与预约在同一事务边界内更新，
避免引入分布式事务。
end note

note bottom of DataPort
业务模块依赖稳定端口，不直接依赖具体存储产品，
便于后续替换数据库、缓存或图片服务。
end note
@enduml
